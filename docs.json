
{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "InspectIQ Help Centre",
  "description": "The official InspectIQ Help Centre. Find guides and tutorials for work orders, home inspections, AI-assisted findings, reports, and business settings.",
  "colors": {
    "primary": "#9A73FF",
    "light": "#9A73FF",
    "dark": "#00C2E3"
  },
  "logo": {
    "light": "/images/InspectIQ_Brevo_Logo_Light_Transparent_1000px.png",
    "dark": "/images/InspectIQLogo_v3_darkmode.png",
    "href": "https://www.myinspectiq.com/"
  },
  "favicon": {
    "light": "/images/favicon.ico",
    "dark": "/images/favicon.ico"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "navbar": {
    "links": [
      {
        "href": "mailto:support@myinspectiq.com",
        "label": "Contact Support"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open App",
      "href": "https://app.myinspectiq.com"
    }
  },
  "footer": {
    "socials": {
      "facebook": "https://facebook.com/myinspectiq",
      "instagram": "https://instagram.com/myinspectiq"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "styling": {
    "eyebrows": "section"
  },
  "navigation": {
    "groups": [
      {
        "group": "Home",
        "pages": [
          "home"
        ]
      },
      {
        "group": "Getting Started",
        "pages": [
          "getting-started/overview",
          "getting-started/account-setup",
          "recommended-workflow",
          "getting-started/first-inspection"
        ]
      },
      {
        "group": "Video Tutorials",
        "pages": [
          "Video-Tutorials-Overview",
          "getting-started-videos"
        ]
      },
      {
