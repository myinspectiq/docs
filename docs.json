{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "InspectIQ Help Centre",
  "colors": {
    "primary": "#9A73FF",
    "light": "#9A73FF",
    "dark": "#00C2E3"
  },
  "favicon": {
    "light": "/images/favicon.ico",
    "dark": "/images/favicon.ico"
  },
  "logo": {
    "light": "/images/InspectIQ_Brevo_Logo_Light_Transparent_1000px.png",
    "dark": "/images/InspectIQLogo_v3_darkmode.png",
    "href": "https://www.myinspectiq.com/"
  },
  "navbar": {
    "links": [
      {
        "label": "Contact Support",
        "href": "mailto:support@myinspectiq.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open App",
      "href": "https://app.myinspectiq.com"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Home",
        "pages": [
          "index"
        ]
      },
      {
        "group": "Getting Started",
        "pages": [
          "getting-started/overview",
          "getting-started/account-setup",
          "getting-started/first-inspection"
        ]
      },
      {
        "group": "Work Orders",
        "pages": [
          "work-orders/overview",
          "work-orders/creating-work-orders",
          "work-orders/scheduling-inspections",
          "work-orders/agreements-signatures"
        ]
      },
      {
        "group": "Inspections",
        "pages": [
          "inspections/overview",
          "inspections/capturing-photos",
          "inspections/area-overviews",
          "inspections/capturing-findings",
          "inspections/ai-generated-findings",
          "inspections/reviewing-editing-findings",
          "inspections/completing-inspection",
          "offline-mode/overview"
        ]
      },
      {
        "group": "Reports",
        "pages": [
          "reports/overview",
          "reports/report-delivery"
        ]
      },
      {
        "group": "Settings & Administration",
        "pages": [
          "settings/business-settings",
          "settings/my-settings",
          "team-management/overview"
        ]
      },
      {
        "group": "Help & Resources",
        "pages": [
          "tips/best-practices",
          "tutorials/video-tutorials",
          "troubleshooting/common-issues",
          "troubleshooting/offline-sync",
          "whats-new/latest-updates"
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "facebook": "https://facebook.com/myinspectiq",
      "instagram": "https://instagram.com/myinspectiq"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "styling": {
    "eyebrows": "section"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "description": "The official InspectIQ Help Centre. Find guides and tutorials for work orders, home inspections, AI-assisted findings, reports, and business settings."
}
